{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terrabellum",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",

  // `wrangler deploy` (et `wrangler dev`) lance d'abord ce build :
  // il compile le client (Vite) dans ./dist.
  "build": {
    "command": "npm run build"
  },

  // Le Worker sert le client compilé. Les routes /api/* passent par le code du Worker.
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"]
  },

  // Base créée à la main en Europe de l'Ouest (weur), au plus près des joueurs.
  // Ne pas retirer le database_id : sans lui, Wrangler recréerait une base là où
  // tourne le build (la première avait atterri à Singapour, +160 ms par requête).
  // Les tables sont créées par le Worker au premier appel (voir src/worker/db.ts).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "terrabellum-eu",
      "database_id": "aab3ef23-6fbf-4b45-8ee4-526649b17120"
    }
  ],

  "observability": {
    "enabled": true
  }
}
